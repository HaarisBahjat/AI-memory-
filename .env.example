# ============================================================
# AI Wellness LMS — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# ============================================================

# -------------------------------------------------------
# APP CORE
# -------------------------------------------------------
APP_NAME="AI Wellness LMS"
APP_VERSION="1.0.0"
DEBUG=true
PORT=8000

# -------------------------------------------------------
# SUPABASE POSTGRESQL (Database: Layers 2, 3, 4)
# Get from: https://supabase.com → Project Settings → Database
#
# Use the "Session Mode" connection string for direct queries.
# Format: postgresql+asyncpg://postgres:[password]@[host]:5432/postgres
#
# For production with high concurrency → use Transaction Mode
# (port 6543) via Supavisor connection pooler.
# -------------------------------------------------------
SUPABASE_DB_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Pool settings for SQLAlchemy (tuned for free tier limits)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -------------------------------------------------------
# REDIS (Layer 1: Sensory Memory + Celery Broker in Phase 7)
# Options:
#   - Local dev:  redis://localhost:6379
#   - Upstash (Free Tier serverless Redis):
#     rediss://:[PASSWORD]@[HOST].upstash.io:6380
# -------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL=1800          # 30 minutes in seconds (Layer 1 sliding window)
REDIS_MAX_MESSAGES=10           # Max messages kept in sensory buffer

# -------------------------------------------------------
# OPENAI (Embeddings + LLM Chat)
# -------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TEMPERATURE=0.3     # Low temp for factual, reproducible wellness responses

# -------------------------------------------------------
# MEMORY RETRIEVAL MATH
# These constants drive the exponential time-decay formula:
#   S_adjusted = S_raw * exp(-DECAY_LAMBDA * delta_days)
# -------------------------------------------------------
DECAY_LAMBDA=0.005              # Decay rate per day (memory loses ~0.5% per day)
SIMILARITY_THRESHOLD=0.65       # Minimum adjusted score to include a memory in context
DEDUP_THRESHOLD=0.88            # Phase 7: Score above which we update vs. duplicate
EPISODIC_ACTIVE_DAYS=14         # Layer 2: Active retrieval window in days
EPISODIC_ARCHIVE_DAYS=90        # Phase 7: Days before episode moves to cold storage

# -------------------------------------------------------
# SECURITY & AUTH (Phase 2)
# -------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------
# CLINICAL SAFETY (Phase 6)
# -------------------------------------------------------
# Crisis resource override response is always returned when
# clinical safety screener triggers — no LLM call is made.
ENABLE_SAFETY_SCREENER=true

# -------------------------------------------------------
# CELERY / BACKGROUND JOBS (Phase 7: Memory Consolidation)
# -------------------------------------------------------
CRON_CONSOLIDATION_SCHEDULE="0 2 * * *"    # 02:00 AM UTC nightly
CONSOLIDATION_EPISODE_WINDOW_DAYS=7        # Analyze last 7 episodes per user

# -------------------------------------------------------
# PHASE 10 - WEARABLE DEVICE TOKENS (Biometric Ingestion)
# -------------------------------------------------------
OURA_API_KEY=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
